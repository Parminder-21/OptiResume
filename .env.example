# .env Template — Copy this to .env and fill in your values
# ---------------------------------------------------------------

# Groq LLM API (required for resume rewriting and chat questions)
# Get your key at: https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_api_key_here

# JWT Secret — REQUIRED. Use a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=replace_with_a_long_random_secret_string

# Model Configuration (defaults shown — override if needed)
MODEL_NAME=llama-3.3-70b-versatile
SBERT_MODEL=all-MiniLM-L6-v2

# Server Configuration
ALLOWED_ORIGINS=http://localhost:5173
MAX_TOKENS=2000

# Token Expiry (minutes) — default is 1440 (24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database — defaults to local SQLite (no setup needed for local dev)
# For production use a PostgreSQL URL:
# DATABASE_URL=postgresql://user:password@host:5432/optiresume
DATABASE_URL=sqlite:///./optiresume.db

# Frontend (Vite) — set this in frontend/.env if you change the backend port
VITE_API_URL=http://localhost:8000/api/v1
